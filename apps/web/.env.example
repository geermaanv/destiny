# Por default el frontend llama a /api, que Next.js proxea server-side a
# API_INTERNAL_URL (ver next.config.ts). No hace falta setear nada para
# correr local ni para hostear con un túnel (un solo túnel alcanza).
#
# NEXT_PUBLIC_API_URL: solo si alguna vez la API vive en otro host/dominio
# distinto del frontend (el browser le pegaría directo, necesitando su
# propio túnel/CORS). Dejar vacío en el caso normal.
# NEXT_PUBLIC_API_URL=http://localhost:8000

# URL interna donde corre apps/api, para el proxy de next.config.ts.
# Default http://localhost:8000 — solo cambiarla si la API corre en otro
# puerto/host dentro de la misma máquina.
# API_INTERNAL_URL=http://localhost:8000
