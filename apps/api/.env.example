DATABASE_URL=postgresql+psycopg://destiny:destiny@localhost:5432/destiny
ENVIRONMENT=development

# Verificación por WhatsApp (spec A3 v1, ADR 0008). Dejar vacías en desarrollo
# para usar el modo mock (botón "Simular envío (dev)" en /onboarding/verificacion).
# WHATSAPP_BUSINESS_NUMBER=5491100000000
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=

# IA para redactar explicaciones y rompehielos vía OpenRouter (spec B5/B7, ADR 0011: la IA solo redacta).
# Sin key, se usan textos de plantilla. El modelo es configurable (ej. anthropic/claude-haiku-4.5).
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=

# Spec A10: false (MVP) = el registro termina sin WhatsApp (verificación opcional desde Perfil);
# true = la verificación por WhatsApp vuelve a ser obligatoria.
VERIFICACION_OBLIGATORIA=false
